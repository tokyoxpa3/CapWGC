// ============================================================================
// app.rc - the project's only resource
// ============================================================================
//
// Why this exists at all: the file icon and the window icon can only come from
// the PE resources - without them Explorer shows the generic blank-document
// icon and the settings window has no taskbar icon.
//
// Two icon resources, not one:
//   IDI_APPICON  idle. Used for the exe, the window class, and the tray.
//   IDI_APPREC   recording. Same tile with a red badge baked into the corner,
//                used only by the tray while a capture is running. It is a
//                second resource rather than a runtime overlay because
//                DrawIconEx into a DIB does not reliably carry the source
//                alpha - on some machines that yields a half-transparent tray
//                icon, which is worse than no state indicator at all.
//
// rc.exe ships with the Windows SDK, which the build already needs for
// windows.h, so this is one more tool invocation, not a new dependency.
//
// app.ico / app_rec.ico are generated from icon.jpg by tools\make_icon.py; do
// not hand-edit them. Keep this file ASCII-only: rc.exe reads it in the OEM
// codepage.

#define IDI_APPICON 101
#define IDI_APPREC  102

IDI_APPICON ICON "app.ico"
IDI_APPREC  ICON "app_rec.ico"
